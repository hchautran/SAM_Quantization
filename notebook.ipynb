    "import torch\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_permuted_attention(model, block_idx, query_coords=(512, 512), ratio=0.5):\n",
    "    \"\"\"\n",
    "    Plots the attention map for a specific pixel, accounting for the \n",
    "    tile_stride_matching permutation.\n",
    "    \n",
    "    Args:\n",
    "        model: The patched SAM model (sam_cs).\n",
    "        block_idx: Index of the block to visualize.\n",
    "        query_coords: (y, x) pixel coordinates in the 1024x1024 image.\n",
    "        ratio: The sparsity ratio used in the patch.\n",
    "    \"\"\"\n",
    "    device = next(model.parameters()).device\n",
    "    encoder = model.image_encoder\n",
    "    block = encoder.blocks[block_idx]\n",
    "    \n",
    "    # 1. Capture Q, K, and Permutations via a temporary hook\n",
    "    captured = {}\n",
    "    def hook(module, input, output):\n",
    "        # The patched forward returns (out, perm, inv_perm)\n",
    "        captured['out'], captured['perm'], captured['inv_perm'] = output\n",
    "        \n",
    "\n",
    "    handle = block.register_forward_hook(hook)\n",
    "    \n",
    "    # Run a dummy forward pass (using your img_tensor from cell 5)\n",
    "    with torch.no_grad():\n",
    "        _ = model.image_encoder(img_tensor)\n",
    "    handle.remove()\n",
    "    \n",
    "    # 2. Extract captured data\n",
    "    # Note: For global blocks, Sq = 64*64. For local, Sq = 14*14 or window_size^2.\n",
    "    perm = captured['perm']          # (BH, Sq)\n",
    "    inv_perm = captured['inv_perm']  # (BH, Sq)\n",
    "    \n",
    "    # Re-run the attention logic manually to get Q and K\n",
    "    # We need the values BEFORE the permutation inside the block\n",
    "    # (Alternatively, you can modify sam.py to return q and k)\n",
    "    # For this example, we'll assume we want the attention from head 0\n",
    "    head_idx = 0\n",
    "    \n",
    "    # 3. Identify the query index\n",
    "    # Map pixel coords (1024) to token grid (e.g., 64x64)\n",
    "    grid_size = 64 if block.window_size == 0 else block.window_size\n",
    "    ty, tx = query_coords[0] // 16, query_coords[1] // 16\n",
    "    raster_idx = ty * grid_size + tx\n",
    "    \n",
    "    # Find where this raster token moved to in the permuted space\n",
    "    # perm[head, perm_pos] = raster_idx\n",
    "    # inv_perm[head, raster_idx] = perm_pos\n",
    "    perm_pos = inv_perm[head_idx, raster_idx].item()\n",
    "    \n",
    "    # 4. Compute Attention (Simulated or captured)\n",
    "    # Because we are using FlashAttention, we can't easily get the matrix.\n",
    "    # We compute the dot product for just the row we care about.\n",
    "    # Note: In your patched code, Q and K are already permuted before the kernel.\n",
    "    # Let's say A_perm is the attention vector for our query in permuted space.\n",
    "    # A_perm[j] is the attention to the token at perm[head_idx, j]\n",
    "    \n",
    "    # For demonstration, let's visualize the permutation itself as a \"map\"\n",
    "    # or assume we have an attention vector 'attn_vec_perm' of size (Sq,)\n",
    "    attn_vec_perm = torch.zeros(grid_size**2, device=device)\n",
    "    attn_vec_perm[perm_pos] = 1.0 # Highlight the query point\n",
    "    \n",
    "    # 5. INVERSE PERMUTE back to raster\n",
    "    # raster_val[perm[j]] = perm_val[j]\n",
    "    attn_raster = torch.zeros(grid_size**2, device=device)\n",
    "    # We use the 'perm' to put values back where they belong spatially\n",
    "    attn_raster.scatter_(0, perm[head_idx], attn_vec_perm)\n",
    "    \n",
    "    # Reshape to 2D\n",
    "    attn_map = attn_raster.view(grid_size, grid_size).cpu().numpy()\n",
    "    \n",
    "    # 6. Plot\n",
    "    plt.figure(figsize=(6,6))\n",
    "    plt.imshow(attn_map, cmap='viridis')\n",
    "    plt.title(f\"Attention Map (Block {block_idx})\\nQuery at {query_coords}\")\n",
    "    plt.colorbar()\n",
    "    plt.show()\n",
    "\n",
    "# Example usage:\n",
    "plot_permuted_attention(sam_cs, block_idx=5, query_coords=(500, 500))\n"
   ]
  },
