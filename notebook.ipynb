    "from algo.sparsesam.patch.channel_sort_sam import apply_patch as channel_sort_sam\n",
    "\n",
    "SORT_BY = 'std'   # 'std' or 'magnitude'\n",
    "\n",
    "sam_cs = copy.deepcopy(sam)\n",
    "sam_cs.image_encoder = sam_cs.image_encoder.half()\n",
